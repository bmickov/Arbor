{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arbor",
  "version": "0.4.2",
  "identifier": "app.arbor.git",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arbor",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A Git client for Linux",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      }
    }
  }
}
