{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arbor",
  "version": "0.6.0",
  "identifier": "app.arbor.git",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arbor",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A friendly Git client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    },
    "longDescription": "Arbor is a Git client for Linux, the BSDs, macOS and Windows: drag-and-drop merging and rebasing, commit reordering, line-by-line staging, and an undo button that covers almost everything.",
    "license": "0BSD",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (C) 2026 The Arbor authors. Released under the 0BSD license.",
    "publisher": "The Arbor authors",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  }
}
